{
  "name": "@meteor-vite/toolkit",
  "version": "1.0.0",
  "bin": "./bin/entrypoint.mjs",
  "description": "Internal toolkit for managing building and publishing meteor-vite's npm and Atmosphere packages.",
  "author": "Jørgen Vatle <Jorgen@WcAServices.net> (https://github.com/JorgenVatle)",
  "files": [
    "bin",
    "dist"
  ],
  "license": "ISC",
  "exports": {
    ".": {
      "types": ["./dist/index.d.mts", "./dist/index.d.ts"],
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run toolkit build . --",
    "toolkit": "node --enable-source-maps ./bin/entrypoint.mjs",

    "preprepare": "node ./bin/prepare.mjs",
    "prepare": "node --enable-source-maps ./bin/entrypoint.mjs build ."
  },
  "dependencies": {
    "globby": "^14.1.0",
    "hasha": "^6.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
