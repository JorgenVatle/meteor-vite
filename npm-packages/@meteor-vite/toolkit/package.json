{
  "name": "@meteor-vite/toolkit",
  "version": "1.0.0",
  "bin": "./dist/bin/entrypoint.mjs",
  "description": "Internal toolkit for managing building and publishing meteor-vite's npm and Atmosphere packages.",
  "author": "Jørgen Vatle <Jorgen@WcAServices.net> (https://github.com/JorgenVatle)",
  "license": "ISC",
  "exports": {
    ".": {
      "types": ["./dist/index.d.mts", "./dist/index.d.ts"],
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup",
    "toolkit": "npm exec @meteor-vite/toolkit",

    "prepare": "npm run build-if-changed . || npm run build",

    "build-if-changed": "npm run toolkit build-if-changed",
    "check-changes": "npm run toolkit check-changes"
  },
  "dependencies": {
    "globby": "^14.1.0",
    "hasha": "^6.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
