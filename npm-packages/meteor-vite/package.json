{
  "name": "meteor-vite",
  "version": "3.9.0-beta.0",
  "description": "Vite compatability plugin for Meteor v3",
  "files": [
    "dist"
  ],
  "main": "",
  "exports": {
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.js",
      "default": "./dist/plugin.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js",
      "default": "./dist/client.mjs"
    },
    "./internals": {
      "types": "./dist/internals.d.mts",
      "import": "./dist/internals.mjs",
      "default": "./dist/internals.mjs"
    },
    "./server-entry/*": {
      "types": "./dist/server-entry/*.d.mts",
      "import": "./dist/server-entry/*.mjs",
      "default": "./dist/server-entry/*.mjs"
    }
  },
  "scripts": {
    "start": "ts-node-dev src/bin/debug/watch-mocks.ts",
    "watch": "npm run build -- --watch",
    "build": "toolkit build",
    "clean": "rm -rf ./dist",
    "prepack": "npm run build",
    "test": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "meteor",
    "vite"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/JorgenVatle/meteor-vite/issues"
  },
  "homepage": "https://github.com/JorgenVatle/meteor-vite",
  "license": "ISC",
  "dependencies": {
    "@babel/parser": "^7.22.5",
    "@babel/traverse": "^7.27.0",
    "execa": "^9.5.1",
    "p-limit": "^3.1.0",
    "picocolors": "^1.1.1",
    "semver": "^7.6.3",
    "source-map-support": "^0.5.21",
    "wrap-ansi": "^9.0.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.23.6",
    "@babel/types": "^7.22.5",
    "@meteor-vite/toolkit": "^1.0.0",
    "@microsoft/api-extractor": "^7.52.8",
    "@types/babel__generator": "^7.6.8",
    "@types/meteor": "^2.9.8",
    "@types/node": "^20.3.3",
    "@types/semver": "^7.5.8",
    "@types/source-map-support": "^0.5.10",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "vite": "^6.0.0"
  }
}
