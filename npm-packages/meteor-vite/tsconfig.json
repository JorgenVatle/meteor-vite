{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "paths": {
      "meteor/jorgenvatle:vite": [
        "../../packages/vite/src/index.d.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "lib": ["es2018", "es2021", "es2022", "es2023", "dom"],
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
    "isolatedDeclarations": false,
    "isolatedModules": true,
    // Todo: enable
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "tsup.config.ts",
    "../../packages/vite/types/**/*.ts",
    "../../packages/vite/src/index.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/.*",
    "dist",
  ]
}
