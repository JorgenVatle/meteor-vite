{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "paths": {
      "meteor/jorgenvatle:vite": [
        "../../packages/vite/src/index.d.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "../../packages/vite/types/**/*.ts",
    "../../packages/vite/src/index.d.ts"
  ]
}
