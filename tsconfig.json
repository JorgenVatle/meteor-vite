{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "mapRoot": "./packages/vite/src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },

  "include": [
    "./packages/vite/**/*.ts"
  ]
}
